<?xml version="1.0" encoding="UTF-8"?>
<!--
  ======================================================================
  PROJETO BIKEHUB - SISTEMA DE GESTÃO DE OFICINA, VENDAS E ALUGUEL
  Arquivo de Configuração do Maven (POM - Project Object Model)
  Linguagem: Java 21 | Framework: Spring Boot 3.3.x
  ======================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    
    <modelVersion>4.0.0</modelVersion>

    <!-- Herança do Starter Parent do Spring Boot para gerenciar versões padrão de plugins e dependências -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.3</version>
        <relativePath/> <!-- Busca o parent diretamente do repositório remoto -->
    </parent>

    <!-- Coordenadas do Projeto BikeHub -->
    <groupId>br.com.projeto</groupId>
    <artifactId>bikehub</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>bikehub</name>
    <description>Sistema Web Completo para Gestão de Oficina Mecânica de Bicicletas, Catálogo de Vendas de Semi-novas e Aluguel</description>

    <!-- Propriedades Globais do Maven: Configurado para a versão estável LTS Java 21 -->
    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- ========================================================== -->
        <!-- 1. SPRING BOOT STARTER WEB                                 -->
        <!-- Fornece suporte para desenvolvimento Web MVC, RESTful APIs, -->
        <!-- roteamento HTTP de Controllers e servidor embutido Tomcat.  -->
        <!-- ========================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ========================================================== -->
        <!-- 2. SPRING BOOT STARTER DATA JPA                            -->
        <!-- Integração ORM com Hibernate para mapeamento de Entidades, -->
        <!-- criação automática de tabelas e interfaces JpaRepository.  -->
        <!-- ========================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ========================================================== -->
        <!-- 3. DRIVER JDBC DO MYSQL                                    -->
        <!-- Conector oficial para comunicação com o SGBD MySQL Server. -->
        <!-- ========================================================== -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ========================================================== -->
        <!-- 4. SPRING BOOT STARTER THYMELEAF                           -->
        <!-- Motor de templates HTML5 moderno no lado do servidor para  -->
        <!-- renderização dinâmica de páginas com th:field, th:each etc -->
        <!-- ========================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- ========================================================== -->
        <!-- 5. SPRING BOOT STARTER VALIDATION                          -->
        <!-- Implementação do Hibernate Validator (JSR-380 / Bean       -->
        <!-- Validation) para anotações @NotBlank, @Email, @NotNull.    -->
        <!-- ========================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ========================================================== -->
        <!-- 6. SPRING BOOT DEVTOOLS                                    -->
        <!-- Ferramenta de produtividade que reinicia automaticamente o -->
        <!-- servidor e atualiza templates Thymeleaf durante o dev.     -->
        <!-- ========================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ========================================================== -->
        <!-- 7. SPRING BOOT STARTER TEST                                -->
        <!-- Suporte para testes unitários e de integração com JUnit 5. -->
        <!-- ========================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Plugin Maven do Spring Boot para empacotar o projeto em JAR executável -->
    <build>
        <!-- O pom fica na raiz, enquanto o backend está dentro de spring-boot-project. -->
        <sourceDirectory>spring-boot-project/src/main/java</sourceDirectory>
        <resources>
            <resource>
                <!-- Inclui application.properties, templates e arquivos estáticos no JAR. -->
                <directory>spring-boot-project/src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
